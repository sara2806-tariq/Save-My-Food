# SaveMyFood Backend Environment Configuration
# Copy this file to .env and insert your real Gemini API key:
# cp .env.example .env

# Your Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (default 3001)
PORT=3001

# Gemma 4 model variant (defaults to gemma-4-26b-a4b-it; also supports gemma-4-31b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it
